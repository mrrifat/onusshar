#!/bin/bash
# Onusshar Bengali Keyboard - macOS Post-Installation Script

set -e

APP_NAME="Onusshar.app"
INSTALL_DIR="/Library/Input Methods"
SOURCE_APP="$2/Applications/$APP_NAME"

echo "Installing Onusshar Bengali Keyboard..."

# Ensure target directory exists
if [ ! -d "$INSTALL_DIR" ]; then
    mkdir -p "$INSTALL_DIR"
fi

# Copy the app to Input Methods directory
echo "Copying $APP_NAME to $INSTALL_DIR..."
if [ -d "$SOURCE_APP" ]; then
    cp -R "$SOURCE_APP" "$INSTALL_DIR/"
    echo "✓ Copied $APP_NAME successfully"
else
    echo "✗ Error: Source app not found at $SOURCE_APP"
    exit 1
fi

# Set proper permissions
echo "Setting permissions..."
chmod -R 755 "$INSTALL_DIR/$APP_NAME"
chown -R root:wheel "$INSTALL_DIR/$APP_NAME"

# Kill and restart Input Method system
echo "Restarting Input Method server..."
killall IMKServer 2>/dev/null || true
sleep 1

# Notify user
echo "✓ Installation complete!"
echo ""
echo "To activate Onusshar:"
echo "1. Open System Settings > Keyboard > Input Sources"
echo "2. Click '+' to add a new input source"
echo "3. Search for 'Bengali' and select 'Onusshar'"
echo "4. Press Control+Space (or your configured shortcut) to switch input methods"
echo ""
echo "Thank you for installing Onusshar!"

exit 0
