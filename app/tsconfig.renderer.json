{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/renderer",
    "rootDir": "./src/renderer",
    "module": "ESNext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "jsx": "react"
  },
  "include": ["src/renderer/**/*"],
  "exclude": ["node_modules", "dist"]
}
