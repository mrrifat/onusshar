{
  "name": "@onusshar/ime-bridge",
  "version": "0.3.1",
  "description": "Native bridge between OS IME and Onusshar core engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:win": "node-gyp rebuild --target=latest --arch=x64 --dist-url=https://electronjs.org/headers",
    "build:mac": "node-gyp rebuild --target=latest --arch=arm64,x64",
    "test": "jest",
    "install": "node-gyp rebuild"
  },
  "gypfile": true,
  "keywords": ["ime", "input-method", "bengali", "native"],
  "author": "Onusshar Contributors",
  "license": "MIT",
  "dependencies": {
    "@onusshar/core": "*",
    "@onusshar/dictionary": "*",
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "node-gyp": "^10.0.1",
    "typescript": "^5.3.2"
  }
}
